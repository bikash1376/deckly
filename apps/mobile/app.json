{
  "expo": {
    "name": "Retenit",
    "slug": "retenit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "retenit",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EDECEA",
    "newArchEnabled": true,
    "android": {
      "package": "app.retenit.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#EDECEA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDECEA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Retenit needs your photos so you can turn a picture of your notes into a deck.",
          "cameraPermission": "Retenit needs the camera so you can scan a page of notes into a deck."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#935B5D"
        }
      ],
      "./plugins/with-unbundled-mlkit"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "bksh01",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ed6a789-ae39-4de2-b43c-6292eed8362b"
      }
    }
  }
}
