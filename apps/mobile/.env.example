# Copy to `apps/mobile/.env` and fill in. Restart the bundler with a cleared
# cache after any change: `pnpm --filter @retenit/mobile start -- --clear`.
#
# Everything here is EXPO_PUBLIC_, which means it is compiled into the APK and
# anyone can read it. That is fine for these three: publishable keys are meant
# to be public. No secret ever belongs in this file. The Groq key, the Neon
# connection string and the RevenueCat secret key live in the Worker.

# Clerk > API Keys > Publishable key. Starts with pk_test_ or pk_live_.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_

# Your Worker. Locally this is what `wrangler dev` prints. On an Android
# emulator, localhost is the emulator itself: use http://10.0.2.2:8787 instead.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787

# RevenueCat > Project > API keys > Google Play. Starts with goog_.
# Leave blank until billing is wired up; the paywall degrades to a notice.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# OPTIONAL. A LanguageTool compatible endpoint for grammar checking in the pad.
# Leave blank and the grammar toggle stays disabled with an explanation.
#
# Do NOT point this at https://api.languagetool.org. Their terms forbid
# automated requests from an app and ask you to self-host or buy Enterprise.
# Self-hosting is one Docker container, about 1 GB of RAM, roughly $5/month:
#   docker run -d -p 8010:8010 erikvl87/languagetool
EXPO_PUBLIC_GRAMMAR_API_URL=
